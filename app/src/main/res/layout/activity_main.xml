package com.downloader.app

import android.os.Bundle
import android.webkit.WebView
import android.webkit.WebViewClient
import android.widget.Button
import android.widget.EditText
import android.widget.Toast
import androidx.appcompat.app.AppCompatActivity
import androidx.lifecycle.lifecycleScope
import androidx.swiperefreshlayout.widget.SwipeRefreshLayout
import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.launch
import kotlinx.coroutines.withContext
import org.json.JSONObject
import java.net.HttpURLConnection
import java.net.URL
import java.net.URLEncoder

class MainActivity : AppCompatActivity() {

    private lateinit var webView: WebView
    private lateinit var etSearch: EditText
    private lateinit var swipeRefreshLayout: SwipeRefreshLayout

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        setContentView(R.layout.activity_main)

        // লেআউট থেকে আইডিগুলো কানেক্ট করা
        swipeRefreshLayout = findViewById(R.id.swipeRefreshLayout)
        etSearch = findViewById(R.id.etSearch)
        webView = findViewById(R.id.webView)

        val btnFacebook = findViewById<Button>(R.id.btnFacebook)
        val btnInstagram = findViewById<Button>(R.id.btnInstagram)
        val btnYoutube = findViewById<Button>(R.id.btnYoutube)
        val btnX = findViewById<Button>(R.id.btnX)

        // WebView সেটিংস
        webView.settings.javaScriptEnabled = true
        webView.settings.domStorageEnabled = true
        webView.webViewClient = object : WebViewClient() {
            override fun onPageFinished(view: WebView?, url: String?) {
                super.onPageFinished(view, url)
                swipeRefreshLayout.isRefreshing = false
                if (url != null) {
                    etSearch.setText(url) // পেজ চেঞ্জ হলে সার্চবারে লিংক আপডেট হবে
                }
            }
        }

        // প্রথমে ডিফল্টভাবে গুগল বা হোমপেজ লোড করতে পারেন অথবা ফেসবুক/ইউটিউব
        webView.loadUrl("https://www.google.com")

        // Swipe to Refresh হ্যান্ডেল করা
        swipeRefreshLayout.setOnRefreshListener {
            webView.reload()
        }

        // সার্চবার বা ইনপুটে কেউ লিংক লিখে সার্চ বা এন্টার দিলে WebView-তে লোড হবে এবং সার্ভারেও পাঠানো যাবে
        etSearch.setOnEditorActionListener { v, _, _ ->
            val query = v.text.toString().trim()
            if (query.isNotEmpty()) {
                val finalUrl = if (query.startsWith("http://") || query.startsWith("https://")) {
                    query
                } else {
                    "https://www.google.com/search?q=$query"
                }
                webView.loadUrl(finalUrl)

                // যদি ইউজার সরাসরি কোনো ভিডিওর লিংক দিয়ে থাকে, তবে ব্যাকগ্রাউন্ডে আমাদের টার্মাক্স সার্ভারে পাঠিয়ে ডাইরেক্ট লিংক চেক করতে পারি
                checkAndFetchVideo(query)
            }
            true
        }

        // প্ল্যাটফর্ম শর্টকাট বাটনগুলোর কাজ
        btnFacebook.setOnClickListener {
            webView.loadUrl("https://www.facebook.com")
        }
        btnInstagram.setOnClickListener {
            webView.loadUrl("https://www.instagram.com")
        }
        btnYoutube.setOnClickListener {
            webView.loadUrl("https://www.youtube.com")
        }
        btnX.setOnClickListener {
            webView.loadUrl("https://twitter.com")
        }
    }

    // টার্মাক্স লোকাল সার্ভারে ভিডিও লিংক পাঠিয়ে ডাইরেক্ট ডাউনলোড লিংক বের করার ফাংশন
    private fun checkAndFetchVideo(videoUrl: String) {
        if (videoUrl.contains("youtube.com") || videoUrl.contains("youtu.be") || videoUrl.contains("facebook.com") || videoUrl.contains("fb.watch")) {
            Toast.makeText(this, "টার্মাক্স সার্ভার থেকে ভিডিও প্রসেস হচ্ছে...", Toast.LENGTH_SHORT).show()

            lifecycleScope.launch {
                val downloadLink = fetchLinkFromServer(videoUrl)
                if (downloadLink != null) {
                    Toast.makeText(this@MainActivity, "ডাইরেক্ট লিংক পাওয়া গেছে!", Toast.LENGTH_LONG).show()
                    // এখানে আপনার পাওয়া `download_link` দিয়ে অ্যান্ড্রয়েডের DownloadManager বা অন্য কোনো ডাউনলোডার দিয়ে ডাউনলোড শুরু করতে পারবেন।
                } else {
                    // লিংক সরাসরি ভিডিওর না হলে বা সার্ভার থেকে না পেলে সাইলেন্ট থাকবে অথবা ব্রাউজ হতে থাকবে
                }
            }
        }
    }

    private suspend fun fetchLinkFromServer(videoUrl: String): String? {
        return withContext(Dispatchers.IO) {
            try {
                val encodedUrl = URLEncoder.encode(videoUrl, "UTF-8")
                val targetUrl = "http://127.0.0.1:5000/get_video?url=$encodedUrl"
                
                val url = URL(targetUrl)
                val connection = url.openConnection() as HttpURLConnection
                connection.requestMethod = "GET"
                connection.connectTimeout = 10000
                connection.readTimeout = 10000

                if (connection.responseCode == HttpURLConnection.HTTP_OK) {
                    val responseString = connection.inputStream.bufferedReader().use { it.readText() }
                    val jsonObject = JSONObject(responseString)
                    
                    if (jsonObject.optBoolean("success", false)) {
                        return@withContext jsonObject.optString("download_url")
                    }
                }
            } catch (e: Exception) {
                e.printStackTrace()
            }
            return@withContext null
        }
    }
}
